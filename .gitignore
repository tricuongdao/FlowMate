# Secrets: never commit real env files (backend/.env holds Atlas + JWT secret)
.env
.env.*
!.env.example
**/.env
**/.env.*

# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db

# Impeccable working artifacts: decision payloads, surface briefs, and the
# review screenshot set. Session-local by nature; DESIGN.md and PRODUCT.md at
# the repo root are the durable records and stay tracked.
#
# Git will not descend into an excluded directory, so the negation has to
# re-include the folder first and then the one file inside it.
.impeccable/*
!.impeccable/REVIEW.md
