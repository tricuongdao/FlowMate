{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://<YOUR-BACKEND-URL>/api/$1" }
  ],
  "env": {
    "VITE_API_URL": "https://<YOUR-BACKEND-URL>/api"
  }
}
